# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:5173/login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Любая длинная случайная строка, например: node -e "console.log(crypto.randomUUID())"
SESSION_SECRET=

# Должен совпадать с Authorization callback URL в настройках OAuth App
OAUTH_REDIRECT_URI=http://localhost:5173/login

# Пусто — встроенный PostgreSQL (PGlite) в папке server/.data.
# Для PostgreSQL из Docker: postgres://postgres:postgres@localhost:5432/gitzrenie
DATABASE_URL=
